# Independent of ../.env. Use a separate AgentMail key scoped to this inbox only.
MARKDOWN_AGENT_API_KEY=
MARKDOWN_AGENT_INBOX=jeffcao-markdown@agentmail.to
# Absolute paths are optional; defaults are private directories under this folder
# and data/codex. Paths, if set, must match these defaults to avoid mixing workers.
MARKDOWN_AGENT_STATE_DIR=
MARKDOWN_AGENT_CODEX_HOME=
MARKDOWN_AGENT_CODEX_PATH=codex
MARKDOWN_AGENT_MODEL=
# No model calls while idle. One message per poll; at most this many launches/day.
MARKDOWN_AGENT_DAILY_LIMIT=20
MARKDOWN_AGENT_TIMEOUT_SECONDS=900
# Optional comma-separated sender allowlist. Recommended during acceptance tests.
MARKDOWN_AGENT_ALLOWED_SENDERS=
# Leave false until the Ubuntu manual acceptance tests pass. configure never enables it.
MARKDOWN_AGENT_ENABLED=false
