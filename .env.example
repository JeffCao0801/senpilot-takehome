AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=jeffcao@agentmail.to
AGENTMAIL_API_BASE_URL=https://api.agentmail.to

# Runtime (Ubuntu service uses Node.js 24+).
DATA_DIR=./data
POLL_SECONDS=20
DAILY_REQUEST_LIMIT=20
MAX_JOB_ATTEMPTS=2
RETENTION_DAYS=7
HEADLESS=true

# Codex uses your ChatGPT login, never an API-key fallback.
PARSER_MODE=codex
CODEX_PATH=codex
# Optional model; leave empty to use the Codex default.
CODEX_MODEL=
# Set an absolute directory exclusively owned by this worker on Ubuntu.
# Run CODEX_HOME=/absolute/path codex login first; see docs/UBUNTU.md.
SENPILOT_CODEX_AUTH_HOME=

# Optional comma-separated allowlist. Leave empty for evaluator requests.
ALLOWED_SENDERS=
# Optional first-scan cutoff; leave empty to process all received requests.
START_AFTER=
